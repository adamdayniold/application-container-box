# Development only. Copy this file to .env for docker compose:
#   cp .env.example .env
# Never commit .env, and never reuse these values anywhere real.
MONGODB_USERNAME=admin
# The password may contain special characters such as @ : / %
MONGODB_PASSWORD=change-me
MONGODB_DB=user-account

# Running without compose (npm run dev)? Put these in .env.local instead.
# Compose publishes Mongo on localhost:27017:
#   MONGODB_URI=mongodb://admin:change-me@localhost:27017
#   MONGODB_DB=user-account
# If the password has special characters (@ : / %), use this form instead:
#   MONGODB_URI=mongodb://localhost:27017
#   MONGODB_USERNAME=admin
#   MONGODB_PASSWORD=change-me
#   MONGODB_DB=user-account
